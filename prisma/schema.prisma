generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_OWNER
  SCHOOL_ADMIN
  COORDINATOR
  TEACHER
  SECRETARY
  GUARDIAN
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  document      String?
  email         String?
  phone         String?
  logoUrl       String?
  timezone      String         @default("America/Sao_Paulo")
  passingGrade  Decimal        @default(6) @db.Decimal(4, 2)
  attendanceWarningPercent Int @default(75)
  active        Boolean        @default(true)
  memberships   Membership[]
  schoolYears   SchoolYear[]
  classGroups   ClassGroup[]
  subjects      Subject[]
  students      Student[]
  announcements Announcement[]
  academicEvents AcademicEvent[]
  academicPeriods AcademicPeriod[]
  timetableEntries TimetableEntry[]
  invitations    Invitation[]
  occurrences    Occurrence[]
  assignments    Assignment[]
  documents      AcademicDocument[]
  councilDecisions CouncilDecision[]
  periodClosures PeriodClosure[]
  conversations Conversation[]
  notifications Notification[]
  absenceJustifications AbsenceJustification[]
  gradeReviewRequests GradeReviewRequest[]
  documentRequirements StudentDocumentRequirement[]
  academicMovements AcademicMovement[]
  annualResults AnnualResult[]
  financialSettings FinancialSettings?
  studentContracts StudentContract[]
  invoices Invoice[]
  payments Payment[]
  receipts Receipt[]
  enrollmentLeads EnrollmentLead[]
  costCenters CostCenter[]
  expenses Expense[]
  revenues Revenue[]
  contractAcceptances ContractAcceptance[]
  leadInteractions LeadInteraction[]
  fileAssets FileAsset[]
  documentTemplates DocumentTemplate[]
  permissionOverrides PermissionOverride[]
  collectionRules CollectionRule[]
  employees Employee[]
  timeEntries TimeEntry[]
  assets Asset[]
  inventoryItems InventoryItem[]
  inventoryMovements InventoryMovement[]
  libraryBooks LibraryBook[]
  libraryLoans LibraryLoan[]
  transportRoutes TransportRoute[]
  transportStops TransportStop[]
  transportAssignments TransportAssignment[]
  canteenItems CanteenItem[]
  canteenOrders CanteenOrder[]
  medicalRecords MedicalRecord[]
  guardianAuthorizations GuardianAuthorization[]
  resources Resource[]
  reservations ResourceReservation[]
  maintenancePlans MaintenancePlan[]
  maintenanceTickets MaintenanceTicket[]
  suppliers Supplier[]
  purchaseOrders PurchaseOrder[]
  automationRules AutomationRule[]
  surveys Survey[]
  surveyResponses SurveyResponse[]
  pedagogicalGoals PedagogicalGoal[]
  assistantQueries AssistantQueryLog[]
  curriculumFrameworks CurriculumFramework[]
  curriculumCompetencies CurriculumCompetency[]
  curriculumMatrices CurriculumMatrix[]
  rubrics Rubric[]
  lessonPlans LessonPlan[]
  pedagogicalInterventions PedagogicalIntervention[]
  competencyAssessments CompetencyAssessment[]
  pedagogicalObservations PedagogicalObservation[]
  questionBank QuestionBankItem[]
  exams Exam[]
  examAttempts ExamAttempt[]
  rubricAssessments RubricAssessment[]
  subscription  Subscription?
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  passwordHash String?
  avatarUrl   String?
  active      Boolean      @default(true)
  memberships Membership[]
  sessions     Session[]
  lessons     Lesson[]     @relation("TeacherLessons")
  grades      Grade[]      @relation("GradeAuthor")
  guardianships StudentGuardian[]
  invitationsSent Invitation[] @relation("InvitationSender")
  occurrencesCreated Occurrence[] @relation("OccurrenceAuthor")
  assignmentsCreated Assignment[] @relation("AssignmentAuthor")
  submissions AssignmentSubmission[]
  studentLinks StudentUser[]
  documentsCreated AcademicDocument[] @relation("DocumentAuthor")
  councilDecisions CouncilDecision[] @relation("CouncilAuthor")
  timetableEntries TimetableEntry[] @relation("TimetableTeacher")
  classSubjects ClassSubject[] @relation("ClassSubjectTeacher")
  employees Employee[] @relation("EmployeeUser")
  conversationParticipants ConversationParticipant[]
  sentMessages Message[] @relation("MessageSender")
  notifications Notification[]
  absenceJustificationsCreated AbsenceJustification[] @relation("AbsenceJustificationCreator")
  absenceJustificationsReviewed AbsenceJustification[] @relation("AbsenceJustificationReviewer")
  gradeReviewRequestsCreated GradeReviewRequest[] @relation("GradeReviewCreator")
  gradeReviewRequestsReviewed GradeReviewRequest[] @relation("GradeReviewReviewer")
  leadInteractions LeadInteraction[] @relation("LeadInteractionAuthor")
  fileAssetsUploaded FileAsset[] @relation("FileAssetUploader")
  medicalRecordsCreated MedicalRecord[] @relation("MedicalRecordAuthor")
  reservationsCreated ResourceReservation[] @relation("ReservationCreator")
  maintenanceTicketsCreated MaintenanceTicket[] @relation("MaintenanceTicketCreator")
  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrderCreator")
  surveysCreated Survey[] @relation("SurveyCreator")
  pedagogicalGoalsCreated PedagogicalGoal[] @relation("PedagogicalGoalCreator")
  assistantQueries AssistantQueryLog[]
  rubricsCreated Rubric[] @relation("RubricCreator")
  lessonPlansCreated LessonPlan[] @relation("LessonPlanCreator")
  interventionsCreated PedagogicalIntervention[] @relation("InterventionCreator")
  competencyAssessmentsCreated CompetencyAssessment[] @relation("CompetencyAssessmentAuthor")
  observationsCreated PedagogicalObservation[] @relation("PedagogicalObservationAuthor")
  questionsCreated QuestionBankItem[] @relation("QuestionAuthor")
  examsCreated Exam[] @relation("ExamAuthor")
  rubricAssessmentsCreated RubricAssessment[] @relation("RubricAssessmentAuthor")
  auditLogs   AuditLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  activeOrganizationId String?
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions    PermissionOverride[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId, role])
  @@index([organizationId, role])
}

model SchoolYear {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  startsAt       DateTime
  endsAt         DateTime
  active         Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classGroups    ClassGroup[]
  academicPeriods AcademicPeriod[]
  periodClosures PeriodClosure[]
  councilDecisions CouncilDecision[]
  annualResults AnnualResult[]

  @@unique([organizationId, name])
}

model ClassGroup {
  id             String       @id @default(cuid())
  organizationId String
  schoolYearId   String
  name           String
  gradeLevel     String?
  shift          String?
  room           String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolYear     SchoolYear   @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  classSubjects  ClassSubject[]
  lessons        Lesson[]
  assignments    Assignment[]
  timetableEntries TimetableEntry[]
  movementsFrom AcademicMovement[] @relation("MovementFromClass")
  movementsTo AcademicMovement[] @relation("MovementToClass")
  lessonPlans LessonPlan[]
  pedagogicalInterventions PedagogicalIntervention[]
  competencyAssessments CompetencyAssessment[]
  exams Exam[]

  @@unique([organizationId, schoolYearId, name])
  @@index([organizationId, schoolYearId])
}

model Subject {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String?
  color          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classSubjects  ClassSubject[]
  lessons        Lesson[]
  grades         Grade[]
  assignments    Assignment[]
  recoveryGrades RecoveryGrade[]
  timetableEntries TimetableEntry[]
  curriculumMatrixSubjects CurriculumMatrixSubject[]
  rubrics Rubric[]
  lessonPlans LessonPlan[]
  competencyAssessments CompetencyAssessment[]
  questionBank QuestionBankItem[]
  exams Exam[]

  @@unique([organizationId, name])
}

model ClassSubject {
  id           String     @id @default(cuid())
  classGroupId String
  subjectId    String
  teacherId    String?
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      User?      @relation("ClassSubjectTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classGroupId, subjectId])
  @@index([teacherId])
}

model Student {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  registration   String
  birthDate      DateTime?
  guardianName   String?
  guardianPhone  String?
  guardianEmail  String?
  cpf            String?
  rg             String?
  addressLine    String?
  addressNumber  String?
  addressDistrict String?
  addressCity    String?
  addressState   String?
  addressZip     String?
  emergencyContactName String?
  emergencyContactPhone String?
  healthNotes    String?
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  attendance     Attendance[]
  grades         Grade[]
  guardians      StudentGuardian[]
  occurrences    Occurrence[]
  invitations    Invitation[]
  userLinks       StudentUser[]
  submissions    AssignmentSubmission[]
  recoveryGrades RecoveryGrade[]
  councilDecisions CouncilDecision[]
  documents      AcademicDocument[]
  documentRequirements StudentDocumentRequirement[]
  academicMovements AcademicMovement[]
  annualResults AnnualResult[]
  contracts StudentContract[]
  invoices Invoice[]
  payments Payment[]
  receipts Receipt[]
  enrollmentLeads EnrollmentLead[]
  contractAcceptances ContractAcceptance[]
  absenceJustifications AbsenceJustification[]
  gradeReviewRequests GradeReviewRequest[]
  libraryLoans LibraryLoan[]
  transportAssignments TransportAssignment[]
  canteenOrders CanteenOrder[]
  medicalRecords MedicalRecord[]
  guardianAuthorizations GuardianAuthorization[]
  pedagogicalInterventions PedagogicalIntervention[]
  competencyAssessments CompetencyAssessment[]
  pedagogicalObservations PedagogicalObservation[]
  examAttempts ExamAttempt[]
  rubricAssessments RubricAssessment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, registration])
  @@index([organizationId, name])
}

model Enrollment {
  id           String     @id @default(cuid())
  studentId    String
  classGroupId String
  active       Boolean    @default(true)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([studentId, classGroupId])
}

model Lesson {
  id           String       @id @default(cuid())
  classGroupId String
  subjectId    String
  teacherId    String
  title        String
  content      String?
  homework     String?
  lessonDate   DateTime
  classGroup   ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      User         @relation("TeacherLessons", fields: [teacherId], references: [id])
  attendance   Attendance[]
  lessonPlan    LessonPlan?
  createdAt    DateTime     @default(now())

  @@index([classGroupId, lessonDate])
  @@index([teacherId, lessonDate])
}

model Attendance {
  id        String           @id @default(cuid())
  lessonId  String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  note      String?
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  justifications AbsenceJustification[]

  @@index([studentId, status])
}

model Grade {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  authorId  String
  period    String
  label     String
  value     Decimal  @db.Decimal(5, 2)
  maxValue  Decimal  @default(10) @db.Decimal(5, 2)
  weight    Decimal  @default(1) @db.Decimal(5, 2)
  notes     String?
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  author    User     @relation("GradeAuthor", fields: [authorId], references: [id])
  reviewRequests GradeReviewRequest[]
  createdAt DateTime @default(now())

  @@index([studentId, subjectId, period])
}

model StudentUser {
  id        String   @id @default(cuid())
  studentId String
  userId    String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, userId])
  @@index([userId])
}

model Assignment {
  id             String       @id @default(cuid())
  organizationId String
  classGroupId   String
  subjectId      String
  authorId       String
  title          String
  description    String?
  dueAt          DateTime?
  maxScore       Decimal?     @db.Decimal(5, 2)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classGroup     ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  author         User         @relation("AssignmentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  submissions    AssignmentSubmission[]
  createdAt      DateTime     @default(now())

  @@index([organizationId, dueAt])
  @@index([classGroupId, dueAt])
}

model AssignmentSubmission {
  id           String      @id @default(cuid())
  assignmentId String
  studentId    String
  userId       String?
  content      String?
  fileUrl      String?
  submittedAt  DateTime    @default(now())
  score        Decimal?    @db.Decimal(5, 2)
  feedback     String?
  assignment   Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  rubricAssessments RubricAssessment[]

  @@unique([assignmentId, studentId])
  @@index([studentId, submittedAt])
}

model RecoveryGrade {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  period    String
  value     Decimal  @db.Decimal(5, 2)
  notes     String?
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([studentId, subjectId, period])
}

model CouncilDecision {
  id             String       @id @default(cuid())
  organizationId String
  studentId      String
  authorId       String
  schoolYearId   String
  period         String
  decision       String
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author         User         @relation("CouncilAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  schoolYear     SchoolYear   @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, schoolYearId, period])
  @@index([studentId, schoolYearId])
}

model AcademicDocument {
  id             String       @id @default(cuid())
  organizationId String
  studentId      String
  authorId       String
  type           String
  title          String
  payload        Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author         User         @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, type, createdAt])
  @@index([studentId, createdAt])
}

model StudentDocumentRequirement {
  id             String       @id @default(cuid())
  organizationId String
  studentId      String
  code           String
  label          String
  required       Boolean      @default(true)
  status         String       @default("PENDING")
  fileUrl        String?
  receivedAt     DateTime?
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, code])
  @@index([organizationId, status])
}

model AcademicMovement {
  id             String       @id @default(cuid())
  organizationId String
  studentId      String
  type           String
  fromClassGroupId String?
  toClassGroupId   String?
  notes          String?
  effectiveAt    DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromClassGroup ClassGroup?  @relation("MovementFromClass", fields: [fromClassGroupId], references: [id], onDelete: SetNull)
  toClassGroup   ClassGroup?  @relation("MovementToClass", fields: [toClassGroupId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId, effectiveAt])
  @@index([studentId, effectiveAt])
}

model AnnualResult {
  id             String       @id @default(cuid())
  organizationId String
  studentId      String
  schoolYearId   String
  status         String
  finalAverage   Decimal?     @db.Decimal(5, 2)
  attendancePercent Decimal?  @db.Decimal(5, 2)
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYear     SchoolYear   @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, schoolYearId])
  @@index([organizationId, schoolYearId, status])
}

model FinancialSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  pixKey         String?
  pixKeyType     String?
  legalName      String?
  document       String?
  receiptPrefix  String       @default("REC")
  defaultDueDay  Int          @default(10)
  lateFeePercent Decimal      @default(2) @db.Decimal(5, 2)
  monthlyInterestPercent Decimal @default(1) @db.Decimal(5, 2)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model StudentContract {
  id             String       @id @default(cuid())
  organizationId String
  studentId      String
  title          String
  startsAt       DateTime
  endsAt         DateTime?
  monthlyAmount  Decimal      @db.Decimal(10, 2)
  discountType   String?
  discountValue  Decimal?     @db.Decimal(10, 2)
  scholarshipLabel String?
  status         String       @default("ACTIVE")
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  acceptances    ContractAcceptance[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([studentId, status])
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  studentId      String
  contractId     String?
  reference      String
  description    String
  dueAt          DateTime
  amount         Decimal      @db.Decimal(10, 2)
  discountAmount Decimal      @default(0) @db.Decimal(10, 2)
  fineAmount     Decimal      @default(0) @db.Decimal(10, 2)
  interestAmount Decimal      @default(0) @db.Decimal(10, 2)
  status         String       @default("OPEN")
  paidAt         DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contract       StudentContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  payments       Payment[]
  receipts       Receipt[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId, status, dueAt])
  @@index([studentId, dueAt])
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  studentId      String
  invoiceId      String
  amount         Decimal      @db.Decimal(10, 2)
  method         String
  externalReference String?
  notes          String?
  paidAt         DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receipts       Receipt[]
  createdAt      DateTime     @default(now())

  @@index([organizationId, paidAt])
  @@index([invoiceId, paidAt])
}

model Receipt {
  id             String       @id @default(cuid())
  organizationId String
  studentId      String
  invoiceId      String?
  paymentId      String?
  number         String
  amount         Decimal      @db.Decimal(10, 2)
  description    String
  issuedAt       DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment        Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, number])
  @@index([studentId, issuedAt])
}

model EnrollmentLead {
  id             String       @id @default(cuid())
  organizationId String
  studentName    String
  birthDate      DateTime?
  guardianName   String
  guardianEmail  String?
  guardianPhone  String
  desiredGrade   String?
  desiredShift   String?
  source         String?
  notes          String?
  status         String       @default("PRE_ENROLLMENT")
  convertedStudentId String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  convertedStudent Student?   @relation(fields: [convertedStudentId], references: [id], onDelete: SetNull)
  interactions   LeadInteraction[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([guardianPhone])
}

model LeadInteraction {
  id             String         @id @default(cuid())
  organizationId String
  leadId         String
  authorId       String
  type           String
  note           String
  nextFollowUpAt DateTime?
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           EnrollmentLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author         User           @relation("LeadInteractionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@index([organizationId, nextFollowUpAt])
  @@index([leadId, createdAt])
}

model PermissionOverride {
  id             String       @id @default(cuid())
  organizationId String
  membershipId   String
  module         String
  canView        Boolean      @default(true)
  canCreate      Boolean      @default(false)
  canUpdate      Boolean      @default(false)
  canDelete      Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([membershipId, module])
  @@index([organizationId, module])
}

model FileAsset {
  id             String       @id @default(cuid())
  organizationId String
  uploadedById   String
  storageKey     String       @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  publicUrl      String?
  category       String
  entityType     String?
  entityId       String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy     User         @relation("FileAssetUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, category, createdAt])
  @@index([entityType, entityId])
}

model DocumentTemplate {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
