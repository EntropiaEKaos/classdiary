DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edusync"
ADMIN_BOOTSTRAP_TOKEN="replace-with-a-long-random-token"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Apenas desenvolvimento/seed. Não use a senha padrão em produção.
SEED_OWNER_EMAIL="admin@edusync.local"
SEED_OWNER_PASSWORD="ChangeMe123!"

# Storage privado S3.
# Em produção, prefira credenciais temporárias/role quando a infraestrutura permitir.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
AWS_REGION="sa-east-1"
S3_REGION="sa-east-1"
S3_BUCKET=""

# Billing SaaS. Deixe BILLING_PROVIDER vazio até configurar credenciais e preços reais.
BILLING_PROVIDER=""
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
MERCADO_PAGO_PRICE_STARTER_BRL=""
MERCADO_PAGO_PRICE_PRO_BRL=""
MERCADO_PAGO_PRICE_ENTERPRISE_BRL=""
