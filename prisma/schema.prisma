model RubricAssessment {
  id             String       @id @default(cuid())
  organizationId String
  rubricId       String
  studentId      String
  submissionId   String?
  authorId       String
  totalScore     Decimal      @default(0) @db.Decimal(7, 2)
  feedback       String?
  details        Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rubric         Rubric       @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submission     AssignmentSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  author         User         @relation("RubricAssessmentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([studentId, rubricId])
}

model Survey {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  title          String
  audience       String
  type           String       @default("NPS")
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("SurveyCreator", fields: [createdById], references: [id], onDelete: Cascade)
  questions      SurveyQuestion[]
  responses      SurveyResponse[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, active, createdAt])
}

model SurveyQuestion {
  id        String   @id @default(cuid())
  surveyId  String
  prompt    String
  type      String   @default("SCORE")
  position  Int
  required  Boolean  @default(true)
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers   SurveyAnswer[]

  @@unique([surveyId, position])
}

model SurveyResponse {
  id             String       @id @default(cuid())
  organizationId String
  surveyId       String
  respondentType String
  respondentRef  String?
  score          Int?
  comment        String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  survey         Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers        SurveyAnswer[]
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([surveyId, createdAt])
}

model SurveyAnswer {
  id         String         @id @default(cuid())
  responseId String
  questionId String
  value      String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
}

model PedagogicalGoal {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  scopeType      String
  scopeId        String?
  title          String
  metric         String
  targetValue    Decimal      @db.Decimal(10, 2)
  currentValue   Decimal      @default(0) @db.Decimal(10, 2)
  startsAt       DateTime
  endsAt         DateTime
  status         String       @default("ACTIVE")
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("PedagogicalGoalCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, endsAt])
}

model AssistantQueryLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  question       String
  intent         String
  responseSummary String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

model ContractAcceptance {
  id             String       @id @default(cuid())
  organizationId String
  contractId     String
  studentId      String
  acceptedByName String
  acceptedByDocument String?
  acceptedAt     DateTime     @default(now())
  ipAddress      String?
  userAgent      String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract       StudentContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contractId])
  @@index([organizationId, acceptedAt])
}

model CostCenter {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String?
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  revenues       Revenue[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
}

model Expense {
  id             String       @id @default(cuid())
  organizationId String
  costCenterId   String?
  description    String
  category       String
  amount         Decimal      @db.Decimal(10, 2)
  dueAt          DateTime
  paidAt         DateTime?
  status         String       @default("OPEN")
  supplier       String?
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter     CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, dueAt])
}

model Revenue {
  id             String       @id @default(cuid())
  organizationId String
  costCenterId   String?
  description    String
  category       String
  amount         Decimal      @db.Decimal(10, 2)
  receivedAt     DateTime
  source         String?
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter     CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId, receivedAt])
}

model StudentGuardian {
  id        String   @id @default(cuid())
  studentId String
  userId    String
  relation  String?
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, userId])
  @@index([userId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           UserRole
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  sentById       String
  studentId      String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sentBy         User         @relation("InvitationSender", fields: [sentById], references: [id], onDelete: Cascade)
  student        Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
}

model Occurrence {
  id             String       @id @default(cuid())
  organizationId String
  studentId      String
  authorId       String
  title          String
  description    String
  severity       String       @default("INFO")
  occurredAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author         User         @relation("OccurrenceAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, occurredAt])
  @@index([studentId, occurredAt])
}

model AcademicPeriod {
  id             String       @id @default(cuid())
  organizationId String
  schoolYearId   String
  name           String
  startsAt       DateTime
  endsAt         DateTime
  order          Int
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolYear     SchoolYear   @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, schoolYearId, name])
  @@unique([organizationId, schoolYearId, order])
  @@index([organizationId, startsAt])
}

model TimetableEntry {
  id             String       @id @default(cuid())
  organizationId String
  classGroupId   String
  subjectId      String
  teacherId      String?
  weekday        Int
  startsAt       String
  endsAt         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classGroup     ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        User?        @relation("TimetableTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId, weekday, startsAt])
  @@index([classGroupId, weekday])
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  subject        String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participants   ConversationParticipant[]
  messages       Message[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String?
  href           String?
  readAt         DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
}

model AbsenceJustification {
  id             String       @id @default(cuid())
  organizationId String
  attendanceId   String
  studentId      String
  createdById    String
  reason         String
  attachmentUrl  String?
  status         String       @default("PENDING")
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendance     Attendance   @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("AbsenceJustificationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  reviewedBy     User?        @relation("AbsenceJustificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@unique([attendanceId])
  @@index([organizationId, status, createdAt])
  @@index([studentId, createdAt])
}

model GradeReviewRequest {
  id             String       @id @default(cuid())
  organizationId String
  gradeId        String
  studentId      String
  createdById    String
  reason         String
  status         String       @default("PENDING")
  reviewedById   String?
  reviewedAt     DateTime?
  response       String?
  proposedValue  Decimal?     @db.Decimal(5, 2)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grade          Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("GradeReviewCreator", fields: [createdById], references: [id], onDelete: Cascade)
  reviewedBy     User?        @relation("GradeReviewReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId, status, createdAt])
  @@index([studentId, createdAt])
}

model AcademicEvent {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  audience       String       @default("ALL")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, startsAt])
}

model PeriodClosure {
  id             String       @id @default(cuid())
  organizationId String
  schoolYearId   String
  period         String
  closedAt       DateTime     @default(now())
  closedById     String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolYear     SchoolYear   @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([organizationId, schoolYearId, period])
  @@index([organizationId, period])
}

model Announcement {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  body           String
  audience       String        @default("ALL")
  publishedAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, publishedAt])
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  plan           String             @default("STARTER")
  status         SubscriptionStatus @default(TRIAL)
  seats          Int                @default(20)
  trialEndsAt    DateTime?
  currentPeriodEnd DateTime?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}
