{
  "name": "classdiary",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/check-migration-baseline.mjs && prisma migrate deploy",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "check": "npm run db:generate && npm run typecheck && npm run lint && npm run build",
    "db:validate": "prisma validate",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "node scripts/check-migration-baseline.mjs && prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.11",
    "pdf-lib": "^1.17.1",
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.16.3",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/pg": "^8.15.5"
  }
}
